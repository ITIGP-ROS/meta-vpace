[Unit]
Description=IVI OTA agent (MQTT campaign -> decrypt -> swupdate)
Documentation=file:/usr/share/doc/ivi-ota-agent/README.md
# Needs DNS and a route before mosquitto_sub/curl will get anywhere. network-online
# (not just network.target) because the agent connects immediately on start.
After=network-online.target time-sync.target
Wants=network-online.target
# TLS to io.adafruit.com fails closed if the clock is wrong, and a board with no
# RTC boots at epoch. Not a hard dependency: a working NTP is not guaranteed.
After=systemd-timesyncd.service

# The installed-version file lives on /data (see VERSION_FILE in the agent), so
# order after the mount.
#
# Wants=, NOT Requires=: this agent FAILS OPEN on a missing /data. It degrades to
# a non-persistent version file and says so in the journal, rather than refusing
# to start -- an agent that will not start also stops answering the dashboard's
# ping and version queries, so the board reads as dead instead of degraded. This
# is the opposite choice to update-coordinator.service, which fails closed on the
# same partition because burning SecOC freshness into a volatile path is not
# self-recoverable, while a lost version number is.
#
# The concrete unit rather than RequiresMountsFor=/data, for the reason spelled
# out in update-coordinator.service: on the first boot after a flash /etc/fstab
# has no /data line when systemd-fstab-generator runs -- mount-data-partition.sh
# is what appends it -- so there is no data.mount unit to bind to.
Wants=data-partition-mount.service
After=data-partition-mount.service

[Service]
Type=simple
ExecStart=/usr/bin/ivi_ota_agent.sh
# The agent is a long-lived subscriber; a dropped broker connection ends
# mosquitto_sub and therefore the script. Always come back, but not in a hot loop.
Restart=always
RestartSec=15

# Runs as root: swupdate writes the rootfs/app and the agent reads a 0600 private
# key. Narrow what that root can reach.
User=root
# /root is an empty read-only tmpfs under ProtectHome=yes, so rclpy cannot
# create $HOME/.ros/log and every `ros2` invocation dies before the vehicle
# lock can be registered. HOME must point at a writable, persistent directory.
Environment=HOME=/var/lib/ivi-ota
StateDirectory=ivi-ota
StateDirectoryMode=0700
ConfigurationDirectory=ivi-ota
ConfigurationDirectoryMode=0700

NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# NOT ProtectSystem=strict: swupdate must write /usr/bin/appIVI and /usr/assets,
# and install-ivi.lua runs `systemctl restart ivi`. Tightening this any further
# breaks the install, not the agent.

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ivi-ota-agent

[Install]
WantedBy=multi-user.target
