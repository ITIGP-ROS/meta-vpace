#!/bin/sh
# ivi-remote-mic — give the IVI app a microphone it does not physically have.
#
#   ivi-remote-mic          receive the RTP stream and feed it to the app (default)
#   ivi-remote-mic stop     tear the virtual mic back down
#
# This board has no audio capture hardware, so a PulseAudio null sink manufactures one:
# its .monitor is a valid capture source, and Qt's default input follows the default
# source, hence set-default-source below rather than just creating the sink.
#
# GStreamer, not PulseAudio's own network modules: this image's trimmed PulseAudio has
# no rtp-send/recv or tunnel-* modules.
#
# RTP/UDP + Opus, not an SSH pipe: TCP blocks on a lost packet over WiFi and drifts the
# mic further behind; RTP's jitter buffer drops late packets and stays current.
set -e

SINK="ivi_mic"
# The source the app actually records from -- not the sink's monitor, see our_remap().
SOURCE="ivi_mic_in"
PORT="${IVI_MIC_PORT:-5004}"
# Bind address. 0.0.0.0 accepts audio from anywhere that can route here; narrow it to
# one interface address if this ever needs to be less exposed than it is.
ADDR="${IVI_MIC_ADDR:-0.0.0.0}"

log() { echo "[ivi-remote-mic] $*"; }

# Finds OUR null sink specifically -- `pactl unload-module module-null-sink` would
# take out auto_null too, the only other sink on a board with no real audio hardware.
our_module() {
    pactl list short modules 2>/dev/null \
        | awk '/module-null-sink/ && /sink_name='"$SINK"'/ { print $1; exit }'
}

# Qt filters device.class="monitor" out of audioInputs(), so the raw .monitor is
# invisible to the app. module-remap-source layers a "filter"-class source on top
# that Qt will accept (pulled in via RDEPENDS on pulseaudio-module-remap-source).
our_remap() {
    pactl list short modules 2>/dev/null \
        | awk '/module-remap-source/ && /source_name='"$SOURCE"'/ { print $1; exit }'
}

case "${1:-receive}" in
stop)
    # Remap first: it reads from the sink's monitor, so tearing the sink out from under
    # it would be the wrong order.
    _ridx=$(our_remap || :)
    if [ -n "$_ridx" ]; then
        pactl unload-module "$_ridx" 2>/dev/null || :
        log "removed the remap source (module $_ridx)"
    fi
    _idx=$(our_module || :)
    if [ -n "$_idx" ]; then
        pactl unload-module "$_idx" 2>/dev/null || :
        log "removed the virtual mic (module $_idx)"
        # No need to restore the default source by hand: with the sink gone,
        # PulseAudio falls back on its own, which lands back on auto_null.monitor.
    fi
    exit 0
    ;;
receive) ;;
*)
    echo "usage: ${0##*/} [receive|stop]" >&2
    exit 2
    ;;
esac

# Fail loudly rather than limping on. The unit is Restart=always, so if PulseAudio is
# not up yet (this races the weston session on a cold boot) systemd simply tries again.
pactl info >/dev/null 2>&1 || {
    echo "[ivi-remote-mic] ERROR: cannot reach PulseAudio." >&2
    echo "[ivi-remote-mic] XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-<unset>} -- this must run" >&2
    echo "[ivi-remote-mic] as the same user PulseAudio does (weston, uid 1000)." >&2
    exit 1
}

# Idempotent: the service can restart without stacking up a second sink each time.
# Matching on the NAME column, not a substring of the whole line, so a description or
# module argument mentioning the name cannot produce a false positive.
if pactl list short sinks 2>/dev/null | awk -v s="$SINK" '$2 == s { found = 1 } END { exit !found }'; then
    log "sink '$SINK' already present"
else
    # device.description has no spaces on purpose: PulseAudio 17 here rejects any
    # sink_properties value containing one, however it's quoted/escaped.
    pactl load-module module-null-sink \
        sink_name="$SINK" \
        sink_properties=device.description=IVI_Remote_Mic \
        rate=16000 channels=1 >/dev/null
    log "created null sink '$SINK' (16 kHz mono)"
fi

# Layer a real (non-monitor) source over the monitor, so Qt will accept it. Idempotent
# for the same reason the sink is.
if pactl list short sources 2>/dev/null | awk -v s="$SOURCE" '$2 == s { found = 1 } END { exit !found }'; then
    log "source '$SOURCE' already present"
    _have_source=1
elif pactl load-module module-remap-source \
        master="${SINK}.monitor" \
        source_name="$SOURCE" \
        source_properties=device.description=IVI_Remote_Mic_Input >/dev/null 2>&1; then
    log "created remap source '$SOURCE' over ${SINK}.monitor"
    _have_source=1
else
    # Degrade rather than refuse to run: audio still arrives and parec can read the
    # monitor, so the transport is testable. Only the app cannot see it.
    _have_source=0
fi

# 16 kHz mono all the way through because that is what Vosk wants -- no resampling in
# the app's own path.
if [ "$_have_source" = "1" ]; then
    pactl set-default-source "$SOURCE"
    log "default source is now $SOURCE — listening for Opus/RTP on ${ADDR}:${PORT}"
else
    pactl set-default-source "${SINK}.monitor"
    echo "[ivi-remote-mic] WARNING: module-remap-source unavailable — falling back to" >&2
    echo "[ivi-remote-mic] ${SINK}.monitor. Audio will arrive and parec can read it, but" >&2
    echo "[ivi-remote-mic] the IVI app will report 'No audio device detected', because Qt" >&2
    echo "[ivi-remote-mic] excludes monitor-class devices. Install pulseaudio-module-remap-source." >&2
fi

# clock-rate=48000 is required by RFC 7587 for Opus/RTP regardless of actual sample
# rate -- do not "fix" it to 16000. sync=false because this is live capture, not
# playback. client-name avoids stream-restore misrouting us via the shared default
# "gst-launch-1.0" name (which has sent this mic out the vehicle's speakers before).
exec gst-launch-1.0 -q \
    udpsrc address="$ADDR" port="$PORT" \
        caps="application/x-rtp,media=(string)audio,clock-rate=(int)48000,encoding-name=(string)OPUS" ! \
    rtpjitterbuffer latency=100 ! \
    rtpopusdepay ! \
    opusdec plc=true ! \
    audioconvert ! audioresample ! \
    audio/x-raw,rate=16000,channels=1 ! \
    pulsesink device="$SINK" sync=false client-name=ivi-remote-mic
