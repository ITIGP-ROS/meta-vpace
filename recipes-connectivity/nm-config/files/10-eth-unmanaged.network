# Keep systemd-networkd off the ethernet port -- NetworkManager owns it, but the stock
# 80-wired.network was still matching it and running DHCP against the static LiDAR
# address, which cost ~2min of boot time waiting on wait-online (no carrier on an
# unplugged sensor port) and risks a rogue DHCP lease overriding the static route.
#
# Unmanaged=yes rather than RequiredForOnline=no: the latter still leaves networkd
# configuring an interface NM owns; unmanaged is ignored by wait-online too.
#
# The 10- prefix matters -- networkd applies the first matching .network by
# lexicographic order, so this must sort ahead of 80-wired.network.

[Match]
Type=ether
Name=!veth*

[Link]
Unmanaged=yes
