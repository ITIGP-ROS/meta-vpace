# Ethernet profile for the LiDAR link (Livox Mid-360S at 192.168.1.148). Everything
# else -- SSH, NTP, DNS -- goes over WiFi (wlu2u2).
#
# address1 must stay /32, never /24 -- a /24 auto-creates a route that has previously
# beaten WiFi's route and killed SSH to the box. No gateway=/dns= either;
# never-default=true keeps this link from ever becoming the default route.
#
# route1_options=src=192.168.1.5 pins the source address; without it the Livox SDK
# won't recognize our replies.
#
# Keep addressN/routeN keys contiguous from 1 -- NM stops at the first missing
# index and silently drops the rest.
#
# Installed 0600 into /usr/lib/NetworkManager/system-connections, not /etc (see
# 20-keyfile-path.conf) -- so this file is read-only on target; edit here and rebuild.

[connection]
id=static-eth
type=ethernet
interface-name=enP8p1s0
autoconnect=true

[ethernet]

[ipv4]
method=manual
address1=192.168.1.5/32
never-default=true
route1=192.168.1.148/32,0.0.0.0,100
route1_options=src=192.168.1.5

[ipv6]
method=disabled
