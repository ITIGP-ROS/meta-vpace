#!/bin/sh
# weston-force-output — give Weston an output to render into with no panel plugged in,
# at 2x the resolution the IVI app is actually designed for.
#
# With nothing plugged into HDMI, weston finds no output and exits 1 (needed because
# remote-display mirrors a real DRM output rather than the RDP backend directly, see
# weston-rdp.ini). Fixed by installing a synthetic EDID advertising 2048x1200 as
# preferred, then forcing the connector's sysfs status to "connected" to re-probe it.
#
# 2048x1200, not 1024x600: weston-rdp.ini sets [output] scale=2 so Qt keeps its
# 1024x600 logical layout but renders 4x the pixels for a sharper RDP mirror --
# 2048x1200 is exactly 2x in both dimensions so the scale divides back cleanly.
#
# EDID, not an [output] mode= line: without an EDID the kernel falls back to
# 1024x768, and mode= alone can't select a resolution the connector doesn't already
# report. A full [output] modeline would also wrongly override a real panel's own
# timing, whereas overriding just the EDID only affects the connector we're forcing.
#
# Not yet verified on hardware: the EDID blob round-trips correctly (decoded back to
# confirm the modeline and checksum), but hasn't been confirmed booting on real
# hardware yet. Falls back to 1024x768 if the debugfs override is rejected.
set -e

log() { echo "[weston-force-output] $*"; }

# EDID 1.3, 128 bytes, one detailed timing descriptor (bytes 54-71) holding the
# standard CVT mode `cvt 2048 1200 60`; byte 127 is the whole-block checksum.
#
# To retarget a different mode, regenerate rather than hand-edit -- the timing
# block and checksum have to change together.
EDID_HEX=$(printf '%s' '
    00ffffff ffffff00 5a030100 01000000
    01240103 800f0978 0aee91a3 544c9926
    0f505400 00000101 01010101 01010101
    01010101 01012d50 00c082b0 2d4088d8
    3a009a5a 0000001c 000000fc 00565041
    43452d49 56490a20 20200000 00fe0031
    30323478 3630300a 20202020 000000fe
    00666f72 6365640a 20202020 20200018
' | tr -d '[:space:]')

# Two steps because the kernel's edid_override handler requires the whole EDID in a
# single write() (EINVAL otherwise), and BusyBox printf chunks its output -- so printf
# builds the blob in a temp file and dd delivers it as one write.
write_edid() {   # <override-path>
    _tmp="/tmp/.weston-edid.$$"
    _esc=$(printf '%s' "$EDID_HEX" | sed 's/../\\x&/g')

    # Safe as a format string: it is nothing but \xNN escapes, no % anywhere.
    # shellcheck disable=SC2059
    if ! printf "$_esc" > "$_tmp"; then
        rm -f "$_tmp"
        return 1
    fi

    # bs=128 count=1 makes the single-write requirement explicit rather than relying
    # on cat's buffer size happening to be larger than the EDID.
    if dd if="$_tmp" of="$1" bs=128 count=1 2>/dev/null; then
        rm -f "$_tmp"
        return 0
    fi
    rm -f "$_tmp"
    return 1
}

_forced=0
for _status in /sys/class/drm/card*-*/status; do
    [ -w "$_status" ] || continue
    _conn=$(dirname "$_status")
    _name=$(basename "$_conn")
    # The connector directory name is card<N>-<CONNECTOR>; debugfs keys off the bare
    # connector name.
    _cname=${_name#*-}

    if [ "$(cat "$_status" 2>/dev/null)" = "connected" ]; then
        log "$_name is really connected — leaving its EDID and mode alone"
        continue
    fi

    # Globbed rather than assuming /sys/kernel/debug/dri/0: the debugfs index does not
    # have to match the card number, and this board also has dri/1 and dri/128.
    _ovr=""
    for _cand in /sys/kernel/debug/dri/*/"$_cname"/edid_override; do
        [ -w "$_cand" ] && { _ovr="$_cand"; break; }
    done

    if [ -n "$_ovr" ] && write_edid "$_ovr"; then
        log "$_name: installed synthetic 2048x1200 EDID"
    else
        # Not fatal. Without the override the kernel's fallback modes still give weston
        # an output -- just 1024x768, so the mirror will not match the app's layout.
        log "WARNING: $_name: could not write edid_override (debugfs not mounted?) —"
        log "         continuing without it; expect 1024x768 instead of 2048x1200"
    fi

    if echo on > "$_status" 2>/dev/null; then
        log "$_name forced on (modes: $(tr '\n' ' ' < "$_conn/modes" 2>/dev/null))"
        _forced=$(( _forced + 1 ))
    else
        log "WARNING: could not force $_name on"
    fi
done

# Not an error: a board with the panel actually plugged in reaches here having forced
# nothing, which is the correct outcome.
log "done ($_forced connector(s) forced)"

# Tell ivi-app.service what device-pixel-ratio to render at: Main.qml is fixed at
# 1024x600, so on the synthetic 2048x1200 output it needs QT_SCALE_FACTOR=2 to keep
# that layout while filling the real buffer (client-side, since [output] scale=2
# doesn't work correctly on this weston+kiosk-shell+NVIDIA stack -- see weston-rdp.ini).
#
# Keyed off the connector's actual mode, not whether this run installed the EDID --
# on a second weston start the connector is already forced-on and skipped above,
# but the mode is still 2048x1200.
_scale_env=/run/ivi-scale.env
_mode_w=0
for _modes in /sys/class/drm/card*-*/modes; do
    _c=$(dirname "$_modes")
    [ "$(cat "$_c/status" 2>/dev/null)" = "connected" ] || continue
    _mode_w=$(sed -n 1p "$_modes" 2>/dev/null | cut -dx -f1)
    break
done

if [ "${_mode_w:-0}" -ge 2048 ] 2>/dev/null; then
    # EnvironmentFile format: bare KEY=VALUE, no `export`, no quotes needed.
    printf 'QT_SCALE_FACTOR=2\n' > "$_scale_env"
    log "mode is ${_mode_w}px wide — wrote $_scale_env (QT_SCALE_FACTOR=2)"
else
    # Removed rather than written as 1: ivi-app.service reads this with a
    # leading `-` (optional), so absent means "Qt default", which is 1.
    rm -f "$_scale_env"
    log "mode is ${_mode_w}px wide — removed $_scale_env (app renders at 1x)"
fi
