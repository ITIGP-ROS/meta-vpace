#!/bin/sh
# Reset the RDP mirror after the box changes networks.
#
# Changing WiFi mid-session leaves the RDP peer socket bound to a now-gone local
# address. Linux doesn't reset it, so weston keeps queueing mirror frames until the
# send buffer fills, and once that peer is unwritable the mirror stops accept()ing
# new clients entirely -- they hang on "Connecting..." with no error. Nothing at the
# TCP, RDP, or weston layer reaps this on its own (checked all three on the board).
#
# A full weston restart, not something smaller: the mirror is a nested weston that
# screen-share.so does not respawn on its own exit, so there's no smaller lever.
# Real fix is dead-peer detection in rdp-backend; this is the cheap workaround.
set -e

DROPIN="/etc/systemd/system/weston.service.d/10-remote-display.conf"
PORT=3389

# Every IPv4 address currently on the box, in /proc/net/tcp's little-endian hex form.
current_addrs_hex() {
    ip -4 -o addr show 2>/dev/null \
        | awk '{ split($4, a, "/"); split(a[1], o, ".");
                 printf "%02X%02X%02X%02X\n", o[4], o[3], o[2], o[1] }'
}

# Detects an ESTABLISHED socket on our port whose local address no longer exists --
# the orphan that justifies a restart. Parsed from /proc/net/tcp since this image's
# BusyBox netstat lacks -p. IPv4 only: the RDP listener binds 0.0.0.0.
has_orphan_peer() {
    _hexport=$(printf '%04X' "$PORT")
    _cur=$(current_addrs_hex)
    awk -v cur="$_cur" -v port="$_hexport" '
        NR > 1 {
            split($2, l, ":")
            if (l[2] == port && $4 == "01" &&
                index("\n" cur "\n", "\n" l[1] "\n") == 0) { found = 1 }
        }
        END { exit !found }
    ' /proc/net/tcp
}

case "${1:-}" in
    --force) FORCE=1 ;;
    "")      FORCE=0 ;;
    *)       echo "usage: ${0##*/} [--force]" >&2; exit 2 ;;
esac

# Remote display off means there is no mirror to reset and no reason to bounce the UI.
if [ -f "$DROPIN" ]; then
    echo "remote display is off — nothing to do."
    exit 0
fi

if [ "$FORCE" != "1" ] && ! has_orphan_peer; then
    echo "no orphaned RDP peer — leaving weston alone."
    exit 0
fi

if [ "$FORCE" = "1" ]; then
    echo "--force given — resetting the mirror without checking for an orphan."
else
    echo "orphaned RDP peer found (local address no longer on this box) — resetting the mirror."
fi

# A bare `systemctl restart weston` stops ivi-app (Requires=) but doesn't start it
# again, so restart it explicitly; tolerate the unit being absent on images without IVI.
systemctl restart weston
if systemctl list-unit-files ivi-app.service >/dev/null 2>&1; then
    systemctl restart ivi-app \
        || echo "warning: ivi-app did not come back — check journalctl -u ivi-app" >&2
fi

echo "mirror reset."
