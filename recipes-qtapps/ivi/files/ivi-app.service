[Unit]
Description=ITI Qt IVI Application
After=weston.service
Requires=weston.service

# Best-effort nudge only — NOT load-bearing, and deliberately without a
# matching After=.
#
# This pulls network-online.target into the boot transaction, which makes it
# somewhat more likely the network is already up by the time weston and the app
# have finished starting. It does not order this unit against the target, so it
# does not close the race on its own.
#
# Do NOT add After=network-online.target. It would hold the app back until
# NetworkManager-wait-online finishes or times out (~30s), leaving a blank head
# unit on precisely the units that have no saved WiFi profile — and WiFi is
# joined *through* this app, so those are the ones that need it soonest.
#
# The real fix is in the app: RosNode watches RTNETLINK and rebuilds its ROS
# node when an IPv4 address appears, because Fast DDS scans interfaces once per
# participant and never rescans. See DriveView/inc/interface_monitor.h.
Wants=network-online.target

[Service]
Type=simple
User=weston
Group=weston
Environment="LANG=C.UTF-8"
Environment=QT_MEDIA_BACKEND=gstreamer
Environment="QT_QPA_PLATFORM=wayland"
Environment="QT_QPA_PLATFORMTHEME=gtk2"
Environment="HOME=/home/weston"
Environment="XDG_RUNTIME_DIR=/run/user/1000"
Environment="WAYLAND_DISPLAY=wayland-1"

# Fast DDS: UDPv4 only, no shared memory. Load-bearing -- without it this app
# receives NOTHING from the ROS publishers, while still appearing correctly
# matched to them.
#
# This app runs as `weston`; the perception publishers run as `root`. Fast DDS
# creates its /dev/shm ports with the creating process's umask (0644), so the
# second user gets read-only access and a RELIABLE reader cannot write its
# ACKNACKs back to the writer's port. Discovery is over UDP multicast and
# succeeds regardless, so `ros2 topic info -v` shows the subscription MATCHED
# with a stable GID and compatible QoS while zero samples are delivered.
#
# Measured, same publisher, same instant: `ros2 topic hz /object_detections_3d`
# gives 9.6 Hz as root, nothing at all as weston, and 9.6 Hz as weston with
# this profile. Whether it happened to work after a given boot depended on
# which user's participant created the shared port first, which is why
# restarting the IVI sometimes appeared to fix it.
#
# See dds-udp-only.xml for the full rationale and the performance tradeoff.
Environment="FASTRTPS_DEFAULT_PROFILES_FILE=/etc/dds-udp-only.xml"

# HiDPI for the RDP mirror. Supplies QT_SCALE_FACTOR=2, and nothing else.
#
# Main.qml is a fixed `ApplicationWindow { width: 1024; height: 600 }` whose
# fonts and icons are fixed-pixel (font.pixelSize: 26, icons 50x50) while its
# containers are fraction-based, so the layout is only correct when QML's
# logical viewport is exactly 1024x600 — and it only gets sharper if that
# viewport is rendered at a device-pixel-ratio above 1. kiosk-shell fullscreens
# us to the whole output, making the viewport (output width / QT_SCALE_FACTOR),
# so the 2048x1200 output wants factor 2: same layout, 4x the pixels.
#
# Written by weston-force-output, which is the one place that knows whether the
# synthetic 2048x1200 EDID is in effect, and which reads the connector's actual
# resulting mode to decide. Deliberately NOT a plain Environment= line here: the
# same unit runs on a vehicle with a real 1024x600 panel, where that EDID is
# never installed, and a hardcoded 2 would give a 512x300 logical viewport and
# cram the 1024-wide layout into half the space (this was tried — the result is
# visibly garbled text and icons).
#
# The leading `-` makes it optional, which is what gives the panel case the
# right answer for free: no file means no QT_SCALE_FACTOR means Qt's default of
# 1. weston-force-output removes the file whenever the mode is under 2048 wide,
# so a fallback to the kernel's 1024x768 modes also lands at 1x rather than
# staying stuck at a 2 that no longer fits.
#
# Ordering is guaranteed: weston-headless-output.service (which runs
# weston-force-output) is Before=weston.service, and this unit is
# After=weston.service.
EnvironmentFile=-/run/ivi-scale.env
ExecStart=/bin/sh -c '. /opt/ros/humble/setup.bash && exec /bin/appIVI'
Restart=on-failure
RestartSec=5

TimeoutStopSec=10

[Install]
WantedBy=graphical.target