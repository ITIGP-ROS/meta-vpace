[Unit]
Description=Ackermann drive stack (ros2_control, EKF, twist_mux, emergency stop)
Documentation=file:/usr/share/ackermann_bringup/launch/robot.launch.py

# This unit makes the vehicle live at power-on: on_activate centres the steering
# a few seconds after boot with no warning (keep hands clear of the linkage).

# Requires=, not Wants=: if can0 isn't configured yet when this starts,
# ros2_control silently reports "active" with the hardware left UNCONFIGURED.
Requires=systemd-networkd-wait-online@can0.service
After=systemd-networkd-wait-online@can0.service

# hardware.yaml and the controller params are read from /opt, but the map default and
# other state live on /data, and localisation downstream depends on it being mounted.
Requires=data-partition-mount.service
After=data-partition-mount.service

# A duplicate drive stack degrades other topics (measured /livox/imu 200Hz ->
# 11.86Hz); one unit enforces single-instance instead of process scanning.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
# rclpy wants a writable HOME for its log directory. Same as update-coordinator.service.
Environment=HOME=/root

ExecStart=/bin/sh -c '. /opt/ros/humble/setup.bash && exec ros2 launch ackermann_bringup robot.launch.py'

# Node status lies about this; CAN tx does not. See the script.
# With Type=simple the unit is not "started" until this exits, so a stack that came up
# uncommandable fails the unit and Restart=on-failure cycles it.
ExecStartPost=/usr/bin/ackermann-drive-ready

# ros2 launch tears its nodes down cleanly on SIGINT; the default SIGTERM leaves them to
# the cgroup sweep. Same as camera-sign-detect.service.
KillSignal=SIGINT
# Longer than the camera's 20 s: this stack has a controller_manager and spawners to
# unwind, and the Livox driver in the companion unit ignores SIGTERM entirely.
TimeoutStopSec=30

Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ackermann-drive

[Install]
WantedBy=multi-user.target
