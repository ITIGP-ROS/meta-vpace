[Unit]
Description=Livox Mid-360 driver and pointcloud-to-laserscan
Documentation=file:/usr/share/ackermann_bringup/launch/lidar.launch.py

# After the drive stack, matching the boot order robot.launch expects (can0 first).
# Wants=, not Requires=: the LiDAR is useful on its own and shouldn't be denied by a
# drive-stack failure.
Wants=ackermann-drive.service
After=ackermann-drive.service

# Two Livox driver instances is silent data corruption, not a crash: one steals the
# IMU port from the other, leaving /livox/imu at 200Hz and no point cloud, with
# everything else looking healthy. Enforcing single-instance is this unit's main job.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
Environment=HOME=/root

# Waits for the Mid-360's static host address rather than wait-online, since
# enP8p1s0 is NetworkManager-managed and wait-online never sees it configured.
# Restart=on-failure retries until NM has the port up.
ExecStartPre=/bin/sh -c 'ip -4 addr show enP8p1s0 | grep -q "inet 192.168.1.5"'

ExecStart=/bin/sh -c '. /opt/ros/humble/setup.bash && exec ros2 launch ackermann_bringup lidar.launch.py'

# The Livox driver does not die on SIGTERM, which would leave it running and cause the
# two-instance corruption above on the next start. KillMode=mixed + SIGINT ensures
# systemd escalates to SIGKILL and sweeps the cgroup.
KillSignal=SIGINT
TimeoutStopSec=20
KillMode=mixed

Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ackermann-lidar

[Install]
WantedBy=multi-user.target
