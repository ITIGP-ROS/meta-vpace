[Unit]
Description=Nav2 navigation (planner, controller, behaviours, BT navigator)
Documentation=file:/usr/share/ackermann_bringup/launch/nav2.launch.py

# Must start after localisation: nav2 activation blocks on a map->base_link
# transform that only exists once AMCL has a pose, otherwise lifecycle_manager
# times out and half the stack never activates.
Wants=ackermann-localization.service
After=ackermann-localization.service

StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
Environment=HOME=/root

ExecStart=/bin/sh -c '. /opt/ros/humble/setup.bash && exec ros2 launch ackermann_bringup nav2.launch.py'

# activate.py is required: the Smac planner's ~14s init overruns
# lifecycle_manager's hardcoded activation timeout, so autostart alone aborts
# bringup. The sleep just covers node spawn; activate.py handles the rest.
ExecStartPost=/bin/sh -c 'sleep 20; . /opt/ros/humble/setup.bash && exec python3 /opt/ros/humble/lib/ackermann_bringup/activate.py'

KillSignal=SIGINT
TimeoutStopSec=30
# activate.py must be allowed to finish before systemd calls the start failed.
TimeoutStartSec=180

Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ackermann-navigation

[Install]
WantedBy=multi-user.target
